{
  "tool_id": "novel_format",
  "name": "小说排版整理",
  "description": "批量把 TXT 小说按段落/章节重新排版并覆盖回书库，可选追加「精校」标签",
  "revision": "0.3.1",
  "author": "unlimited996",
  "publish_date": "2026-11-26",
  "core_api_version": "1.5.0",
  "entry_backend": "tool.NovelFormat",
  "entry_frontend": "index.html",
  "page": "novel_format",
  "repo_url": "https://github.com/unlimited996/mybooks-tool-novel-format",
  "locales": [
    "zh",
    "zh-TW",
    "en"
  ],
  "default_locale": "zh",
  "api_routes": [
    {
      "path": "books",
      "handler": "tool.BooksHandler"
    },
    {
      "path": "text",
      "handler": "tool.TextHandler"
    },
    {
      "path": "save",
      "handler": "tool.SaveHandler"
    },
    {
      "path": "convert",
      "handler": "tool.ConvertHandler"
    }
  ]
}
